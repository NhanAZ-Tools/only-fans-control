<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:OnlyFansControl;assembly=OnlyFansControl"
        Title="Only Fans Control" Width="788" Height="782" MinWidth="720" MinHeight="620"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F8FE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#23354B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#586D85"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#D8E6F5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2472C7"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1F0FF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#205E9E"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B54327"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E8F0F9"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18,16"/></Style>
  </Window.Resources>
  <ScrollViewer Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,6">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" Background="{StaticResource AccentSoftBrush}" CornerRadius="13" Margin="0,0,13,0">
          <icons:LucideIcon Icon="fan" Width="26" Height="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Only Fans Control" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Your fan. Your preferred speed." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="TrayButton" Grid.Column="2" VerticalAlignment="Center" ToolTip="Hide to the system tray and keep monitoring." AutomationProperties.Name="To tray"><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="minimize-2" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="To tray" VerticalAlignment="Center"/></StackPanel></Button>
      </Grid>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <icons:LucideIcon Icon="laptop" Width="18" Height="18" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock x:Name="DeviceName" Text="Detecting your device…" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceDetail" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"><icons:LucideIcon x:Name="PowerIcon" Icon="plug" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/><TextBlock x:Name="BatteryLabel" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="thermometer" Width="14" Height="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/><TextBlock Text="EC TEMPERATURE" Style="{StaticResource Caption}"/></StackPanel>
          <TextBlock x:Name="TemperatureValue" Text="—" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,3"/>
          <TextBlock x:Name="TemperatureHint" Text="Reading sensors" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" MinHeight="29"/>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="fan" Width="14" Height="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/><TextBlock Text="FAN" Style="{StaticResource Caption}"/></StackPanel>
          <TextBlock x:Name="FanValue" Text="—" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,3"/>
          <TextBlock x:Name="FanHint" Text="Reading sensors" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" MinHeight="29"/>
        </StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="cpu" Width="14" Height="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/><TextBlock Text="CPU LOAD" Style="{StaticResource Caption}"/></StackPanel>
          <TextBlock x:Name="LoadValue" Text="—" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,3" Foreground="{StaticResource AccentBrush}"/>
          <TextBlock x:Name="MemoryHint" Text="" Style="{StaticResource Caption}" FontSize="11" MinHeight="29"/>
        </StackPanel></Border>
      </Grid>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="FAN MODE" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="PowerSource" Grid.Column="1" Style="{StaticResource Caption}" Text="EC · 0x2F"/>
      </Grid>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="CustomButton" Padding="14,14" HorizontalContentAlignment="Left" AutomationProperties.Name="Custom"><StackPanel><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="sliders-horizontal" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Custom" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Level 1–7 or Max" FontSize="11" Margin="26,5,0,0"/></StackPanel></Button>
        <Button x:Name="MaxButton" Grid.Column="2" Padding="14,14" HorizontalContentAlignment="Left" AutomationProperties.Name="Max"><StackPanel><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="zap" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Max" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Maximum speed" FontSize="11" Margin="26,5,0,0"/></StackPanel></Button>
        <Button x:Name="BiosButton" Grid.Column="4" Padding="14,14" HorizontalContentAlignment="Left" AutomationProperties.Name="BIOS default"><StackPanel><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="shield-check" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="BIOS default" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Firmware control" FontSize="11" Margin="26,5,0,0"/></StackPanel></Button>
        <Button x:Name="SmartButton" Grid.Column="6" Padding="14,14" HorizontalContentAlignment="Left" AutomationProperties.Name="Smart auto"><StackPanel><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="activity" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Smart auto" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Follow the curve" FontSize="11" Margin="26,5,0,0"/></StackPanel></Button>
      </Grid>
      <UniformGrid x:Name="LevelsPanel" Columns="8" Margin="0,2,0,10"/>
      <TextBlock Text="Mode and level changes apply immediately. Smart auto uses the highest EC temperature." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="1,0,0,5"/>
      <TextBlock x:Name="ModeStatus" Text="Connecting to the EC…" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" MinHeight="36" Margin="1,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="chart-line" Width="14" Height="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/><TextBlock Text="Recent CPU load" Style="{StaticResource Caption}"/></StackPanel>
            <TextBlock x:Name="UpdateLabel" Grid.Column="1" Style="{StaticResource Caption}" FontSize="11"/>
          </Grid>
          <Canvas x:Name="HistoryCanvas" Height="58" Margin="0,10,0,0" ClipToBounds="True"/>
        </StackPanel>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SensorStatus" Text="Connecting to sensors…" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="ConfigButton" Grid.Column="1" FontSize="12" Margin="0,0,8,0" ToolTip="Smart auto reloads only_fans_config.json when the file changes." AutomationProperties.Name="Open config"><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="settings-2" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Open config" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="SensorsButton" Grid.Column="2" FontSize="12" AutomationProperties.Name="EC connection"><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="circuit-board" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="EC connection" VerticalAlignment="Center"/></StackPanel></Button>
      </Grid>
      <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Close → keep running in tray. Exit or sleep → restore BIOS default." Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="ExitButton" Grid.Column="1" FontSize="11" Padding="10,7" AutomationProperties.Name="Exit and restore BIOS"><StackPanel Orientation="Horizontal"><icons:LucideIcon Icon="power" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Exit · restore BIOS" VerticalAlignment="Center"/></StackPanel></Button>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
